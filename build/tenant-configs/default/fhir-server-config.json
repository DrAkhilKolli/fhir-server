{
    "__comment": "FHIR Server configuration — default tenant (Supabase: yqtyrgovlmwfftpoxgux). Replace <KEYCLOAK_HOST> with your Keycloak hostname before uploading to R2.",
    "fhirServer": {
        "core": {
            "tenantIdHeaderName": "X-FHIR-TENANT-ID",
            "datastoreIdHeaderName": "X-FHIR-DSID",
            "originalRequestUriHeaderName": "X-FHIR-FORWARDED-URL",
            "checkReferenceTypes": true,
            "conditionalDeleteMaxNumber": 10,
            "serverRegistryResourceProviderEnabled": false,
            "disabledOperations": "",
            "defaultFhirVersion": "4.0"
        },
        "security": {
            "cors": true,
            "basic": { "enabled": false },
            "certificates": { "enabled": false },
            "oauth": {
                "enabled": true,
                "regUrl":   "https://auth.example.com/realms/clinic/clients-registrations/openid-connect",
                "authUrl":  "https://auth.example.com/realms/clinic/protocol/openid-connect/auth",
                "tokenUrl": "https://auth.example.com/realms/clinic/protocol/openid-connect/token",
                "smart": {
                    "enabled": true,
                    "scopes": ["openid", "profile", "fhirUser", "launch/patient", "patient/*.*", "offline_access"],
                    "capabilities": [
                        "sso-openid-connect", "launch-standalone", "client-public",
                        "client-confidential-symmetric", "permission-offline",
                        "context-standalone-patient", "permission-patient"
                    ]
                }
            },
            "validateBinarySecurityContext": true
        },
        "audit": {
            "serviceClassName": "org.linuxforhealth.fhir.audit.impl.NopService",
            "serviceProperties": {}
        },
        "persistence": {
            "factoryClassname": "org.linuxforhealth.fhir.persistence.jdbc.FHIRPersistenceJDBCFactory",
            "common": { "updateCreateEnabled": true },
            "jdbc": {
                "enableCodeSystemsCache": true,
                "enableParameterNamesCache": true,
                "enableResourceTypesCache": true
            },
            "datasources": {
                "default": {
                    "type": "postgresql",
                    "currentSchema": "fhirdata",
                    "searchOptimizerOptions": {
                        "from_collapse_limit": 12,
                        "join_collapse_limit": 12
                    }
                }
            }
        },
        "bulkdata": { "enabled": false },
        "operations": {
            "erase": {
                "enabled": true,
                "allowedRoles": ["FHIROperationAdmin", "FHIRUsers"]
            }
        }
    }
}
