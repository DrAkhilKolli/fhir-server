<server>
    <!-- ============================================================== -->
    <!-- TENANT: default; DSID: default; TYPE: read-write               -->
    <!-- Supabase PostgreSQL project: yqtyrgovlmwfftpoxgux              -->
    <!--                                                                 -->
    <!-- Environment variables required at runtime:                     -->
    <!--   SUPABASE_DEFAULT_DB_USER     (e.g. postgres)                 -->
    <!--   SUPABASE_DEFAULT_DB_PASSWORD                                  -->
    <!-- ============================================================== -->
    <dataSource id="fhirDefaultDefault"
                jndiName="jdbc/fhir_default_default"
                type="javax.sql.XADataSource"
                statementCacheSize="200"
                syncQueryTimeoutWithTransactionTimeout="true"
                validationTimeout="30s">
        <jdbcDriver javax.sql.XADataSource="org.postgresql.xa.PGXADataSource"
                    libraryRef="sharedLibPostgres"/>
        <properties.postgresql
             serverName="db.yqtyrgovlmwfftpoxgux.supabase.co"
             portNumber="5432"
             databaseName="postgres"
             user="${env.SUPABASE_DEFAULT_DB_USER}"
             password="${env.SUPABASE_DEFAULT_DB_PASSWORD}"
             currentSchema="fhirdata"
             ssl="true"
             sslmode="require"/>
        <connectionManager
             maxPoolSize="50"
             minPoolSize="5"
             connectionTimeout="60s"
             maxIdleTime="5m"
             numConnectionsPerThreadLocal="0"/>
    </dataSource>
</server>
