{
    "__comment": "FHIR Server configuration - Default Tenant (Supabase: yqtyrgovlmwfftpoxgux)",
    "fhirServer": {
        "core": {
            "tenantIdHeaderName": "X-FHIR-TENANT-ID",
            "datastoreIdHeaderName": "X-FHIR-DSID",
            "originalRequestUriHeaderName": "X-FHIR-FORWARDED-URL",
            "checkReferenceTypes": true,
            "conditionalDeleteMaxNumber": 10,
            "serverRegistryResourceProviderEnabled": false,
            "disabledOperations": "",
            "defaultFhirVersion": "4.0"
        },
        "security": {
            "cors": true,
            "basic": {
                "enabled": false
            },
            "certificates": {
                "enabled": false
            },
            "oauth": {
                "enabled": true,
                "__comment": "Keycloak shared clinic realm. Per-tenant overrides are stored in Cloudflare R2 and applied at startup.",
                "regUrl": "https://<KEYCLOAK_HOST>/realms/clinic/clients-registrations/openid-connect",
                "authUrl": "https://<KEYCLOAK_HOST>/realms/clinic/protocol/openid-connect/auth",
                "tokenUrl": "https://<KEYCLOAK_HOST>/realms/clinic/protocol/openid-connect/token",
                "smart": {
                    "enabled": true,
                    "scopes": ["openid", "profile", "fhirUser", "launch/patient", "patient/*.*", "offline_access"],
                    "capabilities": [
                        "sso-openid-connect",
                        "launch-standalone",
                        "client-public",
                        "client-confidential-symmetric",
                        "permission-offline",
                        "context-standalone-patient",
                        "permission-patient"
                    ]
                }
            },
            "validateBinarySecurityContext": true
        },
        "notifications": {
            "common": {},
            "websocket": {
                "__comment": "only enable this for single-tenant, single-server deployments",
                "enabled": false
            },
            "kafka": {
                "enabled": false
            },
            "nats": {
                "enabled": false
            }
        },
        "audit": {
            "serviceClassName": "org.linuxforhealth.fhir.audit.impl.NopService",
            "serviceProperties": {}
        },
        "persistence": {
            "factoryClassname": "org.linuxforhealth.fhir.persistence.jdbc.FHIRPersistenceJDBCFactory",
            "common": {
                "__comment": "Configuration properties common to all persistence layer implementations",
                "updateCreateEnabled": true
            },
            "jdbc": {
                "__comment": "Configuration properties for the JDBC persistence implementation",
                "enableCodeSystemsCache": true,
                "enableParameterNamesCache": true,
                "enableResourceTypesCache": true
            },
            "datasources": {
                "default": {
                    "__comment": "Supabase PostgreSQL project yqtyrgovlmwfftpoxgux. JNDI: jdbc/fhir_default_default",
                    "type": "postgresql",
                    "currentSchema": "fhirdata",
                    "searchOptimizerOptions": {
                        "from_collapse_limit": 12,
                        "join_collapse_limit": 12
                    }
                }
            }
        },
        "bulkdata": {
            "enabled": false
        },
        "operations": {
            "erase": {
                "enabled": true,
                "allowedRoles": [
                    "FHIROperationAdmin",
                    "FHIRUsers"
                ]
            }
        }
    }
}
