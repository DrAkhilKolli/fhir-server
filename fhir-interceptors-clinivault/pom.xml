<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.linuxforhealth.fhir</groupId>
        <artifactId>fhir-parent</artifactId>
        <version>5.0.0-SNAPSHOT</version>
        <relativePath>../fhir-parent</relativePath>
    </parent>

    <artifactId>fhir-interceptors-clinivault</artifactId>
    <name>Clinivault FHIR Persistence Interceptors</name>
    <description>
        Per-tenant isolation and audit interceptors for the LinuxForHealth FHIR Server.
        Validates that incoming JWT tenant_id / realm / DSID claims match the Liberty
        tenant routing derived from the X-FHIR-TENANT-ID header, then emits a structured
        JSON audit record for every read / write operation.
    </description>
    <packaging>jar</packaging>

    <dependencies>

        <!-- FHIR SPI — persistence interceptor interface and event types -->
        <dependency>
            <groupId>org.linuxforhealth.fhir</groupId>
            <artifactId>fhir-server-spi</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- FHIR persistence event context (FHIRPersistenceEvent) -->
        <dependency>
            <groupId>org.linuxforhealth.fhir</groupId>
            <artifactId>fhir-persistence</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- FHIRRequestContext.get() / tenant + datastore id accessors -->
        <dependency>
            <groupId>org.linuxforhealth.fhir</groupId>
            <artifactId>fhir-config</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Jakarta JSON-P API (used for audit record construction) -->
        <dependency>
            <groupId>jakarta.json</groupId>
            <artifactId>jakarta.json-api</artifactId>
            <version>2.1.0</version>
            <scope>provided</scope>
        </dependency>

        <!-- JUnit 5 for unit tests -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <outputDirectory>${project.build.directory}</outputDirectory>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
